# ─── Database ────────────────────────────────────────────────────────────────
#
# Where benchmark results are stored.
# "sqlite" is the default — results are saved locally in a single file.
# Switch to "supabase" only if you want results stored in the cloud
# (required for the public dashboard).
#
DB_ADAPTER=sqlite
SQLITE_PATH=./results/clawbattle.db


# ─── Supabase: Targets ───────────────────────────────────────────────────────
#
# Optional. Only needed if you want to sync target definitions (CSS Battle
# challenge metadata + reference images) from a shared Supabase project
# instead of using the bundled targets/ directory.
#
# How to get these values:
#   1. Create a project at https://supabase.com
#   2. Run packages/db/schema.sql in the Supabase SQL editor
#   3. Copy Project URL and the "service_role" key from
#      Project Settings → API
#
SUPABASE_TARGETS_URL=
SUPABASE_TARGETS_KEY=


# ─── Supabase: Results ───────────────────────────────────────────────────────
#
# Optional. Only needed when DB_ADAPTER=supabase or when using the ⇅ Sync tab
# to upload/download results from the cloud (e.g. to share results across
# machines or power the public dashboard).
#
# Can be the same Supabase project as above, or a separate one.
#
# How to get these values: same as above (URL + service_role key).
# The anon key is used by the public dashboard build (set as a GitHub Secret,
# not here).
#
SUPABASE_RESULTS_URL=
SUPABASE_RESULTS_KEY=


# ─── Prompt ──────────────────────────────────────────────────────────────────
#
# Default prompt version used by the CLI runner and API.
# Must match a directory name under prompts/ (e.g. v1, v2).
# Can be overridden per-run with --prompt v1 on the CLI or in the dashboard.
#
PROMPT_VERSION=v2


# ─── LLM Providers ───────────────────────────────────────────────────────────
#
# Add keys for the providers you want to use. Unused entries can be left blank.
#
# OpenRouter (recommended — gives access to most models via one key):
#   https://openrouter.ai/keys
#
# OpenAI (direct, for GPT and o-series models):
#   https://platform.openai.com/api-keys
#
# Ollama (local models — no key needed; set OLLAMA_API_KEY only to use Ollama Cloud):
#   Local:  http://localhost:11434 (default)
#   Cloud:  https://ollama.com + OLLAMA_API_KEY from https://ollama.com/settings/keys
#
OPENROUTER_API_KEY=
# Optional: custom path for model-specific OpenRouter provider routing overrides.
# If unset, ClawBattle looks for ./config/openrouter.providers.json.
OPENROUTER_PROVIDER_CONFIG_PATH=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Leave blank for local Ollama; set when using Ollama Cloud or any auth-gated endpoint.
OLLAMA_API_KEY=


# ─── Token Budget ────────────────────────────────────────────────────────────
#
# When a run specifies reasoning_max_tokens, the OpenRouter adapter sends
# a top-level max_tokens = reasoning_max_tokens + ANSWER_TOKEN_BUDGET.
# This is required because some providers (Moonshot Kimi, etc.) ignore
# reasoning.max_tokens and only respect top-level max_tokens.
# The buffer must be large enough to hold the final code answer after thinking.
#
ANSWER_TOKEN_BUDGET=4096
