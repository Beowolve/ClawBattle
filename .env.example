# Database adapter for benchmark results: sqlite | supabase
DB_ADAPTER=sqlite
SQLITE_PATH=./results/clawbattle.db

# Supabase – Targets (battle_targets, daily_targets)
SUPABASE_TARGETS_URL=
SUPABASE_TARGETS_KEY=

# Supabase – Results (runs, run_meta) — separate project, used when DB_ADAPTER=supabase
SUPABASE_RESULTS_URL=
SUPABASE_RESULTS_KEY=

# Default prompt version used by CLI and API (must match a directory under prompts/)
PROMPT_VERSION=v2

# LLM Providers (add the ones you use)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
